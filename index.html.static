    ingredients: ["00 Wheat Dough","Cheese-Stuffed Crust","Tomato Sauce","Mozzarella","Chicken","Herbs"] },
  { name: "Chicken Double Cheese", reg:290, med:500, lrg:690,
    img: "https://images.unsplash.com/photo-1541745537411-b8046dc6d66c?w=600",
    desc: "When one cheese isn't enough — double mozzarella with our premium chicken. Extra creamy, extra stretchy, extra delicious.",
    ingredients: ["00 Wheat Dough","Tomato Sauce","Double Mozzarella","Parmesan","Chicken","Basil"] },
  { name: "Spicy Chicken Pizza", reg:250, med:480, lrg:650,
    img: "https://images.unsplash.com/photo-1593560708920-61dd98c46a4e?w=600",
    desc: "Not for the faint-hearted! Fiery spiced chicken with jalapeños and chilli flakes for a bold, heat-forward pizza that will thrill spice lovers.",
    ingredients: ["00 Wheat Dough","Spicy Tomato Sauce","Mozzarella","Spiced Chicken","Jalapeños","Chilli Flakes"] },
  { name: "4 Chicken Loaded Pizza", reg:350, med:550, lrg:810,
    img: "https://images.unsplash.com/photo-1528137871618-79d2761e3fd5?w=600",
    desc: "Loaded with FOUR types of chicken preparations! The ultimate non-veg extravaganza for serious pizza enthusiasts. Legendary status guaranteed.",
    ingredients: ["00 Wheat Dough","Special Sauce","Mozzarella","Grilled Chicken","BBQ Chicken","Tandoori Chicken","Chicken Salami"] }
];

const vegBurgers = [
  {name:"Tikki Burger", price:65, sub:"Crispy Aloo Tikki"},
  {name:"Veg Burger", price:80, sub:"Classic Veggie"},
  {name:"Veg Cheese", price:100, sub:"With Cheese Slice"},
  {name:"Spicy Burger", price:90, sub:"Extra Chilli"},
  {name:"Spicy Cheese", price:110, sub:"Spicy + Cheese"},
  {name:"Paneer St. Che. Burger", price:150, sub:"Stuffed Cheese Paneer"}
];
const nonvegBurgers = [
  {name:"Chi. Burger", price:100, sub:"Chicken Patty"},
  {name:"Spicy Chi. Burger", price:110, sub:"Extra Spicy"},
  {name:"Spicy Chi. Cheese Burger", price:130, sub:"Spicy + Cheese"},
  {name:"Chi. Cheese", price:120, sub:"With Cheese Slice"},
  {name:"Crispy Chicken", price:160, sub:"Crispy Fried"},
  {name:"Crispy Cheese Chi.", price:180, sub:"Crispy + Cheese"},
];
const combos = [
  {name:"Veg Burger Combo", price:145, sub:"Burger + Fries + Coke"},
  {name:"Chi. Burger Combo", price:170, sub:"Burger + Fries + Coke"},
  {name:"Double Cheese Add-On", price:40, sub:"Any Burger"}
];
const fries = [
  {name:"Salted Fries", price:70, sub:"Classic"},
  {name:"Peri Peri", price:90, sub:"Spicy"},
  {name:"Chipotle Deep", price:130, sub:"Smoky"},
  {name:"Tandoori Mayo", price:130, sub:"Indian Flavour"},
  {name:"Cheese Fries", price:150, sub:"Loaded Cheese"},
  {name:"Cheese with Chocolate", price:180, sub:"Sweet & Salty"}
];
const momosData = [
  {name:"Veg", steam:80, fried:100},
  {name:"Veg Schezwan", steam:90, fried:110},
  {name:"Paneer", steam:110, fried:130},
  {name:"Cheese Corn", steam:120, fried:140},
  {name:"Chicken", steam:120, fried:140}
];
const garlicBread = [
  {name:"Garlic Bread", price:120, sub:"Classic"},
  {name:"Paneer Bread", price:150, sub:"With Paneer"},
  {name:"Stuffed Bread", price:140, sub:"Stuffed"},
  {name:"Spicy Stuffed", price:160, sub:"Extra Spicy"},
  {name:"Cheese Deep (add-on)", price:20, sub:"Per bread"}
];
const nuggets = [
  {name:"Veg Nuggets", price:120, sub:"Crispy Veg"},
  {name:"Garlic Potato Pops", price:150, sub:"Garlicky"},
  {name:"Cheesy Corn Triangles", price:140, sub:"Triangles"},
  {name:"Chicken Nuggets", price:170, sub:"Juicy Chicken"},
  {name:"Chicken Pop Corn", price:160, sub:"Bite-Sized"},
  {name:"Veb Panjabi Samosa", price:20, sub:"Punjabi Style"}
];

// ===== CART =====
let cart = [];
let currentSizeKey = 'reg';
let currentNvSizeKey = 'nvreg';
let modalItem = null;
let modalSelectedSize = null;

// ===== RENDER =====
function renderPizzaGrid(containerId, data, isVeg) {
  const container = document.getElementById(containerId);
  container.innerHTML = data.map((p,i) => `
    <div class="pizza-card" onclick="openModal(${isVeg ? 'vegPizzas' : 'nonvegPizzas'},${i})">
      <div class="pizza-img-wrap">
        <img class="pizza-card-img" src="${p.img}" alt="${p.name}" loading="lazy">
        <span class="${isVeg ? 'veg-badge' : 'nonveg-badge'}">${isVeg ? '● VEG' : '● NON-VEG'}</span>
      </div>
      <div class="pizza-card-body">
        <div class="pizza-card-name">${p.name}</div>
        <div class="pizza-card-desc">${p.desc.substring(0,70)}...</div>
        <div class="pizza-card-footer">
          <div class="pizza-price">
            ₹<span class="price-val-${i}">${isVeg ? p.reg : p.reg}</span>
            <small>${isVeg ? 'Regular' : 'Regular'}</small>
          </div>
          <button class="add-btn" onclick="event.stopPropagation(); openModal(${isVeg ? 'vegPizzas' : 'nonvegPizzas'},${i})">VIEW +</button>
        </div>
      </div>
    </div>
  `).join('');
}

function renderExtrasGrid(containerId, items, isVeg) {
  const container = document.getElementById(containerId);
  container.innerHTML = items.map((item,i) => `
    <div class="extras-card" onclick="addToCart('${item.name}', ${item.price}, '${isVeg===true ? 'Veg':''}')">
      <div>
        <div class="extras-name">${item.name}</div>
        <div class="extras-sub">${item.sub}</div>
      </div>
      <div>
        <div class="extras-price">₹${item.price}</div>
        <button class="add-btn" style="margin-top:6px;font-size:10px;padding:5px 10px;">ADD</button>
      </div>
    </div>
  `).join('');
}

function renderMomosTable() {
  const tbody = document.getElementById('momos-body');
  tbody.innerHTML = momosData.map(m => `
    <tr>
      <td>${m.name}</td>
      <td><button class="add-btn" style="font-size:11px" onclick="addToCart('${m.name} Momos (Steamed)', ${m.steam})">₹${m.steam} ADD</button></td>
      <td><button class="add-btn" style="font-size:11px" onclick="addToCart('${m.name} Momos (Fried)', ${m.fried})">₹${m.fried} ADD</button></td>
    </tr>
  `).join('');
}

// ===== TABS =====
function switchTab(tabId) {
  document.querySelectorAll('.menu-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + tabId).classList.add('active');
  event.target.classList.add('active');
}

const sizeMap = { reg:'reg', med:'med', lrg:'lrg', nvreg:'reg', nvmed:'med', nvlrg:'lrg' };
function switchSize(btn, key) {
  btn.closest('.size-tabs').querySelectorAll('.size-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const isVeg = ['reg','med','lrg'].includes(key);
  if(isVeg) {
    currentSizeKey = key;
    renderPizzaGrid('veg-grid', vegPizzas, true);
  } else {
    currentNvSizeKey = key;
    renderPizzaGrid('nonveg-grid', nonvegPizzas, false);
  }
}

// ===== MODAL =====
function openModal(datasetStr, idx) {
  const dataset = datasetStr === 'vegPizzas' ? vegPizzas : nonvegPizzas;
  const isVeg = datasetStr === 'vegPizzas';
  const p = dataset[idx];
  modalItem = { ...p, isVeg };
  modalSelectedSize = { label: 'Regular', price: p.reg };

  document.getElementById('modal-img').src = p.img;
  document.getElementById('modal-title').textContent = p.name;
  const badge = document.getElementById('modal-badge');
  badge.textContent = isVeg ? '🟢 Pure Veg' : '🔴 Non-Veg';
  badge.className = 'modal-badge ' + (isVeg ? 'veg' : 'nonveg');
  document.getElementById('modal-desc').textContent = p.desc;

  document.getElementById('modal-ingredients').innerHTML = p.ingredients.map(i =>
    `<span class="ingredient-chip">${i}</span>`).join('');

  const sizes = [
    {label:'Regular', price: p.reg},
    {label:'Medium', price: p.med},
    {label:'Large', price: p.lrg}
  ];
  document.getElementById('modal-sizes').innerHTML = sizes.map((s,i) => `
    <div class="modal-size-btn ${i===0?'selected':''}" onclick="selectSize(this,'${s.label}',${s.price})">
      <span class="modal-size-label">${s.label}</span>
      <span class="modal-size-price">₹${s.price}</span>
    </div>
  `).join('');

  document.getElementById('modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function selectSize(el, label, price) {
  document.querySelectorAll('.modal-size-btn').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  modalSelectedSize = {label, price};
}

function addFromModal() {
  if(!modalItem || !modalSelectedSize) return;
  addToCart(`${modalItem.name} (${modalSelectedSize.label})`, modalSelectedSize.price);
  closeModal();
  toggleCart();
}

function closeModal() {
  document.getElementById('modal').classList.remove('open');
  document.body.style.overflow = '';
}
function closeModalOutside(e) {
  if(e.target === document.getElementById('modal')) closeModal();
}

// ===== CART =====
function addToCart(name, price, tag) {
  cart.push({name: tag ? name : name, price});
  updateCartUI();

  // Flash cart icon
  const btn = document.querySelector('.cart-btn');
  btn.style.transform = 'scale(1.3)';
  setTimeout(() => btn.style.transform = '', 300);
}

function removeFromCart(idx) {
  cart.splice(idx, 1);
  updateCartUI();
}

function updateCartUI() {
  document.getElementById('cart-count').textContent = cart.length;
  const total = cart.reduce((s,i) => s + i.price, 0);
  document.getElementById('cart-total').textContent = `₹${total}`;

  const container = document.getElementById('cart-items');
  if(cart.length === 0) {
    container.innerHTML = `<div class="cart-empty"><i class="fas fa-basket-shopping"></i><span>Your basket is empty</span></div>`;
    return;
  }
  container.innerHTML = cart.map((item,i) => `
    <div class="cart-item">
      <div>
        <div class="cart-item-name">${item.name}</div>
      </div>
      <div style="display:flex;align-items:center;gap:8px">
        <div class="cart-item-price">₹${item.price}</div>
        <button class="cart-item-remove" onclick="removeFromCart(${i})"><i class="fas fa-trash"></i></button>
      </div>
    </div>
  `).join('');
}

function toggleCart() {
  document.getElementById('cart-sidebar').classList.toggle('open');
}

function checkoutWhatsApp() {
  if(cart.length === 0) { alert("Add some items first!"); return; }
  const phone = "917738009029";
  const total = cart.reduce((s,i) => s + i.price, 0);
  let msg = "🍕 *NEW ORDER - PIZZOO*%0A" + "═".repeat(26) + "%0A";
  cart.forEach((item,i) => {
    msg += `*${i+1}.* ${item.name} — ₹${item.price}%0A`;
  });
  msg += "═".repeat(26) + "%0A*TOTAL: ₹" + total + "*%0A%0APlease confirm my order!";
  window.open(`https://wa.me/${phone}?text=${msg}`, '_blank');
}

// ===== MOBILE NAV =====
function toggleMobileNav() {
  document.getElementById('navbar').classList.toggle('mobile-open');
}

// ===== INTRO DISMISS =====
window.addEventListener('load', () => {
  setTimeout(() => {
    document.getElementById('intro-screen').classList.add('hide');
  }, 6000);
});

// ===== SCROLL REVEAL =====
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// ===== INIT =====
renderPizzaGrid('veg-grid', vegPizzas, true);
renderPizzaGrid('nonveg-grid', nonvegPizzas, false);
renderExtrasGrid('veg-burger-grid', vegBurgers, true);
renderExtrasGrid('nonveg-burger-grid', nonvegBurgers, false);
renderExtrasGrid('combo-grid', combos, null);
renderExtrasGrid('fries-grid', fries, null);
renderMomosTable();
renderExtrasGrid('garlic-grid', garlicBread, null);
renderExtrasGrid('nuggets-grid', nuggets, null);

// Re-observe after render
setTimeout(() => {
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
}, 100);
</script>
</body>
</html>
